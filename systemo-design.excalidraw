    {
      "id": "LOtzqxWrBBRPQvLV3o08z",
      "type": "text",
      "x": -1497.7350400690773,
      "y": 1113.933136556065,
      "width": 1473.9718017578125,
      "height": 781.2027761966136,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aO",
      "roundness": null,
      "seed": 1822722150,
      "version": 863,
      "versionNonce": 640142714,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1744539380506,
      "link": null,
      "locked": false,
      "text": "Strings in redis\n\nsyntax : set <entity_name> : <entity id> value\n\n':' - makes group in redis db\n\nset key_name: id value nx  ---> nx pushes only if this is a new key \n\nmget key1 key2 .... keyn ----> multiple get keys\n\nmset key1:id1 value1 key2:id2 value2 .....keyn :idn valunen ---> multiple set\n\nwe can also set expiry for key TTL (Time to Live)\n\n ",
      "fontSize": 41.66414806381939,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Strings in redis\n\nsyntax : set <entity_name> : <entity id> value\n\n':' - makes group in redis db\n\nset key_name: id value nx  ---> nx pushes only if this is a new key \n\nmget key1 key2 .... keyn ----> multiple get keys\n\nmset key1:id1 value1 key2:id2 value2 .....keyn :idn valunen ---> multiple set\n\nwe can also set expiry for key TTL (Time to Live)\n\n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
