    {
      "name": "Poll_Person1_Match",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "const pollCount = parseInt(pm.environment.get(\"poll_count1\") || \"0\");",
              "pm.environment.set(\"poll_count1\", pollCount + 1);",
              "if (response.status === \"pending\" && pollCount < 12) {",
              "    setTimeout(() => postman.setNextRequest(\"Poll_Person1_Match\"), 5000);",
              "} else {",
              "    pm.environment.set(\"poll_count1\", \"0\");",
              "    if (response.status === \"no_match\") {",
              "        pm.test(\"Person1 match failed\", () => {",
              "            pm.expect(response.status).to.equal(\"matched\", \"Person1 not matched\");",
              "        });",
              "    } else {",
              "        pm.environment.set(\"person1_eta\", response.data?.eta);",
              "        pm.environment.set(\"person1_driver\", response.data?.DRIVER_ID);",
              "        pm.test(\"Person1 matched\", () => {",
              "            pm.expect(response.status).to.equal(\"matched\");",
              "            pm.expect(response.data.DRIVER_ID).to.be.oneOf([\"DRV1\", \"DRV2\"]);",
              "            pm.expect(response.data.eta).to.be.a(\"number\");",
              "        });",
              "    }",
              "    postman.setNextRequest(\"Poll_Person2_Match\");",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3002/ride/match/{{requestId1}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3002",
          "path": ["ride", "match", "{{requestId1}}"]
        }
      },
      "response": []
    },
    {
      "name": "Poll_Person2_Match",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "const pollCount = parseInt(pm.environment.get(\"poll_count2\") || \"0\");",
              "pm.environment.set(\"poll_count2\", pollCount + 1);",
              "if (response.status === \"pending\" && pollCount < 12) {",
              "    setTimeout(() => postman.setNextRequest(\"Poll_Person2_Match\"), 5000);",
              "} else {",
              "    pm.environment.set(\"poll_count2\", \"0\");",
              "    if (response.status === \"no_match\") {",
              "        pm.test(\"Person2 match failed\", () => {",
              "            pm.expect(response.status).to.equal(\"matched\", \"Person2 not matched\");",
              "        });",
              "    } else {",
              "        const eta1 = parseFloat(pm.environment.get(\"person1_eta\") || 0);",
              "        const eta2 = response.data?.eta || 0;",
              "        const driver1 = pm.environment.get(\"person1_driver\");",
              "        const driver2 = response.data?.DRIVER_ID;",
              "        const totalWaitTime = eta1 + eta2;",
              "        pm.environment.set(\"total_wait_time\", totalWaitTime);",
              "        pm.test(\"Person2 matched\", () => {",
              "            pm.expect(response.status).to.equal(\"matched\");",
              "            pm.expect(response.data.DRIVER_ID).to.be.oneOf([\"DRV1\", \"DRV2\"]);",
              "            pm.expect(response.data.eta).to.be.a(\"number\");",
              "        });",
              "        pm.test(\"Optimal assignment\", () => {",
              "            pm.expect(totalWaitTime).to.equal(8, `Total wait time is ${totalWaitTime} min, expected 8 min`);",
              "            pm.expect(driver1).to.equal(\"DRV2\", `Person1 got ${driver1}, expected DRV2`);",
              "            pm.expect(driver2).to.equal(\"DRV1\", `Person2 got ${driver2}, expected DRV1`);",
              "        });",
              "        console.log(`Total Wait Time: ${totalWaitTime} min`);",
              "        console.log(`Person1: ${driver1}, ETA ${eta1} min`);",
              "        console.log(`Person2: ${driver2}, ETA ${eta2} min`);",
              "    }",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3002/ride/match/{{requestId2}}",
